{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    // Typecheck against the protocol's source, not its dist/, so a fresh checkout typechecks with no build first.
    "paths": {
      "@isoplan/protocol": ["./packages/protocol/src/index.ts"]
    }
  }
}
