{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    // The workspace uses the protocol's source, not its dist/, so a fresh checkout typechecks and
    // bundles with no build first: tsc, rolldown (packages/mod/build.mjs) and Bun all read this.
    "paths": {
      "@isoplan/protocol": ["./packages/protocol/src/index.ts"]
    }
  }
}
